# Database
DATABASE_URL=postgresql://user:password@localhost:5432/comp_crawl

# Gmail SMTP
GMAIL_ADDRESS=your-email@gmail.com
GMAIL_APP_PASSWORD=your-app-password

# Email recipients (comma-separated)
DIGEST_RECIPIENTS=recipient1@example.com,recipient2@example.com

# LLM (via LiteLLM - supports OpenAI, Anthropic, NVIDIA NIM, Ollama, etc.)
# --- Pick one provider and uncomment ---

# OpenAI
# LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=your-openai-key

# Anthropic
# LLM_MODEL=claude-sonnet-4-20250514
# ANTHROPIC_API_KEY=your-anthropic-key

# NVIDIA NIM (cloud)
LLM_MODEL=nvidia_nim/meta/llama-3.1-70b-instruct
NVIDIA_NIM_API_KEY=your-nvidia-api-key

# NVIDIA NIM (self-hosted)
# LLM_MODEL=openai/meta/llama-3.1-70b-instruct
# OPENAI_API_BASE=http://localhost:8000/v1
# OPENAI_API_KEY=not-needed
